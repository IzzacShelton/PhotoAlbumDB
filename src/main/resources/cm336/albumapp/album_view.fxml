<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cm336.albumapp.controller.AlbumViewController">

    <top>
        <ToolBar>
            <items>
                <Button onAction="#onBack" text="← Back" />
                <Label fx:id="albumTitleLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                <Pane HBox.hgrow="ALWAYS" />
                <Label text="Filter by tag:" />
                <ComboBox fx:id="tagFilterBox" onAction="#onFilterChanged" promptText="All" />
            </items>
        </ToolBar>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <content>
                <StackPane fx:id="gridContainer" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
                    <children>
                        <Label fx:id="emptyPlaceholder" mouseTransparent="true" style="-fx-text-fill: #888888; -fx-font-size: 16px; -fx-font-style: italic;" text="Album is empty. Click or right-click to import photos." />
                        <FlowPane fx:id="photoGrid" hgap="10.0" vgap="10.0" />
                    </children>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
   <bottom>
      <HBox alignment="CENTER" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="albumInfo" alignment="CENTER" contentDisplay="CENTER" text="albumInfo" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </bottom>

</BorderPane>
