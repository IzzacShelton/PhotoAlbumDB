<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cm336.albumapp.controller.AlbumGalleryController">

    <top>
        <ToolBar>
            <items>
                <Label text="Albums" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <TextField fx:id="newAlbumNameField" promptText="New album name…"/>
                <Button text="+ New Album" onAction="#onCreateAlbum"/>
            </items>
        </ToolBar>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <!-- Album card nodes are added here programmatically -->
                <FlowPane fx:id="albumGrid"
                          hgap="16" vgap="16"
                          style="-fx-padding: 16;"/>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
